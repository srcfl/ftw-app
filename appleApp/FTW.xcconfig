// Settings the app and its widget extension must agree on, in one place.
// Both targets build on this file through the project.

// The App Group the app and widgets share. Written here once: every
// entitlements file and Info.plist reads it as $(FTW_APP_GROUP), and Swift
// reads it back from Info.plist (AppGroupFiles.infoKey). The Apple Watch
// app and its complications use the same name; an App Group stays on one
// device, so the watch holds its own copy, filled from the phone.
FTW_APP_GROUP = group.energy.ftw.app

// An extension's version must match its app's.
MARKETING_VERSION = 0.6.1
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 26.0
WATCHOS_DEPLOYMENT_TARGET = 26.0

// Sourceful's Apple team, for the app and the widget alike. Signing is
// automatic: Xcode, signed in to that team, makes the profiles. Nothing for
// signing is committed here: no certificate, profile or key.
DEVELOPMENT_TEAM = L66M368PZ6
CODE_SIGN_STYLE = Automatic

// Simulator builds sign ad hoc and need no Apple account, for CI and for
// anyone without one. The entitlements, and with them the App Group, still
// travel with the app.
CODE_SIGN_IDENTITY[sdk=iphonesimulator*] = -
CODE_SIGN_IDENTITY[sdk=watchsimulator*] = -

// The commit Source & licenses links to, which the license asks the app to
// offer. scripts/release.sh passes the full commit (FTW_SOURCE_REVISION=<sha>).
// Left empty, the "Record the source revision" phase asks git, and a tree
// with changes is a local build that links to the repository instead.
FTW_SOURCE_REVISION =
