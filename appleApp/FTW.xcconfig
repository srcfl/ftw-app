// Settings the app and its widget extension must agree on, in one place.
// Both targets build on this file through the project.

// The App Group the app and widgets share. Written here once: both
// entitlements files and both Info.plists read it as $(FTW_APP_GROUP), and
// Swift reads it back from Info.plist (AppGroupFiles.infoKey).
FTW_APP_GROUP = group.energy.ftw.app

// An extension's version must match its app's.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 26.0

// Sourceful's Apple team, for the app and the widget alike. Signing is
// automatic: Xcode, signed in to that team, makes the profiles. Nothing for
// signing is committed here: no certificate, profile or key.
DEVELOPMENT_TEAM = L66M368PZ6
CODE_SIGN_STYLE = Automatic

// Simulator builds sign ad hoc and need no Apple account, for CI and for
// anyone without one. The entitlements, and with them the App Group, still
// travel with the app.
CODE_SIGN_IDENTITY[sdk=iphonesimulator*] = -
